                , <&kp I>
                , <&kp SQT>;
        };

        // yi' (Yank Inner Single-quote) copies the text inside single quotes without deleting it. It is a "read-only" operation that saves the string content to your register.
        Single_Quote_Yank: Single_Quote_Yank {
            label = "&SINGLE_QUOTE_YANK";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
