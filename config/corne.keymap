                , <&kp I>
                , <&kp LS(SQT)>;
        };

        // di' (Delete Inner Single-quote) erases the text inside single quotes but leaves the quotes themselves intact. Crucially, it keeps you in Normal Mode rather than switching you to Insert
        Single_Quote_Deletion: Single_Quote_Deletion {
            label = "&SINGLE_QUOTE_DELETION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D>
                , <&kp I>
                , <&kp SQT>;
        };

        // di" (Delete Inner Double-quote) removes the content within double quotes. Like all "delete" commands in Neovim, the removed text is saved to your register (clipboard), effectively acting as a "cut" operation.
        Double_Quote_Deletion: Double_Quote_Deletion {
            label = "&DOUBLE_QUOTE_DELETION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D>
                , <&kp I>
                , <&kp LS(SQT)>;
        };

        // [d is a navigation command used to jump the cursor to the previous diagnostic (error, warning, or hint) in your current file. In Flutter development, where widget trees can become massive, this is the fastest way to find why your code isn't compiling without scrolling manually.
        The_Previous_Diagnostic_Jump: The_Previous_Diagnostic_Jump {
            label = "&THE_PREVIOUS_DIAGNOSTIC_JUMP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT>
                , <&kp D>;
        };

        // ]d is a navigation shortcut that jumps your cursor to the next diagnostic (error, warning, or hint) further down in your file. It is the primary way to "audit" your code after a big refactor in Flutter. Instead of hunting for red lines with your mouse, you let the LSP snap your cursor exactly where the logic is broken.
        The_Next_Diagnostic_Jump: The_Next_Diagnostic_Jump {
            label = "&THE_NEXT_DIAGNOSTIC_JUMP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT>
                , <&kp D>;
        };

        // [E (Capital E) is a navigation command used to jump the cursor to the previous Error-level diagnostic in your file. While [d stops at everything (warnings, hints, and notes), [E ignores the small stuff and takes you only to the "breaking" code that is preventing your Flutter app from compiling or running.
        Previous_Critical_Error_Jump: Previous_Critical_Error_Jump {
            label = "&PREVIOUS_CRITICAL_ERROR_JUMP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT>
                , <&kp E>;
        };

        // ]E (Capital E) is a navigation command that jumps your cursor to the next Error-level diagnostic in your file. While the lowercase ]d stops at every minor warning or styling hint, ]E specifically targets "breaking" errors—the ones that cause red squiggly lines and prevent your code from compiling.
        Next_Critical_Error_Jump: Next_Critical_Error_Jump {
            label = "&NEXT_CRITICAL_ERROR_JUMP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT>
                , <&kp E>;
        };

        // dap (Delete Around Paragraph) deletes the entire paragraph your cursor is currently in, along with the blank line following it. In programming, Neovim defines a "paragraph" as a block of text separated by empty lines.
        Paragraph_Eraser: Paragraph_Eraser {
