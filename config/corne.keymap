        herdr_toggle_side_bar: herdr_toggle_side_bar {
            label = "&HERDR_TOGGLE_SIDE_BAR";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp LSHFT>
                , <&kp S>;
        };
    };
};

/* Automatically generated behavior definitions */
/ {
    behaviors {

        // Layer tap dance behaviors

        ZMK_TD_LAYER(td_LAYER_Numbers, 1)

        // this when pressed it presses enter when hold, it goes to vim layer
        vim_enter: vim_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <>;
        };
    };
};

/* Automatically generated combos definitions */
/ {
    combos {
        compatible = "zmk,combos";

        combo_Another_symbol_layer {
            timeout-ms = <25>;
            key-positions = <POS_LH_T2 POS_RH_T3 POS_RH_C3R4 POS_RH_C3R2>;
            bindings = <&sl LAYER_simbols_layer>;
        };

        // This will show all the symbol layers
        combo_symbol_layer {
            timeout-ms = <25>;
            key-positions = <POS_RH_T2 POS_LH_T3 POS_LH_C1R3 POS_LH_C3R3>;
            bindings = <&sl LAYER_Symbols>;
        };

        // ThIs will press the alt key until another key is pressed
        combo_Alt_key {
            timeout-ms = <30>;
            key-positions = <POS_RH_T2 POS_RH_C2R3>;
            bindings = <&sk LALT>;
        };

        combo_Last_used_tap_session {
            timeout-ms = <30>;
            key-positions = <POS_LH_T3 POS_LH_C4R3>;
            bindings = <&kp LC(N6)>;
        };

        combo_combo_faster_shift {
            timeout-ms = <80>;
            key-positions = <POS_RH_T2 POS_LH_T3>;
            bindings = <&sk_fast LSHIFT>;
        };

        combo_surfingkey_layer {
            key-positions = <POS_LH_T2 POS_RH_T2>;
            bindings = <&mo LAYER_Surfingkey>;
        };

        combo_combo_fast_ctrl {
            timeout-ms = <30>;
            key-positions = <POS_RH_T2 POS_RH_C3R3>;
            bindings = <&sk LCTRL>;
        };

        // This will pressed gui key until another key is pressed
        combo_GUI_Key {
            timeout-ms = <30>;
            key-positions = <POS_RH_C3R3 POS_RH_C2R3>;
            bindings = <&sk LGUI>;
        };

        // This is combo for toggling numbers layers
        combo_Toggle_numbers_layers {
            timeout-ms = <33>;
            key-positions = <POS_RH_C4R3 POS_RH_C3R3>;
            bindings = <&to LAYER_Numbers>;
        };

        // This will toggle something like capslock
        combo_CAPSWORD {
            timeout-ms = <30>;
            key-positions = <POS_LH_C4R3 POS_LH_C3R3>;
            bindings = <&caps_word>;
        };

        // This is combo for toggling numbers layers
        combo_kitty_sessions {
            timeout-ms = <50>;
            key-positions = <POS_LH_T3 POS_RH_T3>;
            bindings = <&mo LAYER_kitty_workspaces_sessions>;
        };

        combo_password_manager {
            timeout-ms = <45>;
            key-positions = <POS_LH_T2 POS_LH_C4R3>;
            bindings = <&sl LAYER_passwords>;
        };
    };
};


/* ---- Keymap (order defines layer index) ---- */
/ {
    keymap {
        compatible = "zmk,keymap";

        // ---- BASE: Colemak-DH ("kuru"), Go60 rows R2/R3/R4 + thumbs ----
        // Dropped from the Go60 base: number row, and inner row `grave DEL BSPC | RCTRL [ ]`.
        layer_kuru {
            bindings = <
   &kp TAB   &kp Q   &kp W   &kp F   &kp P   &kp B          &kp J   &kp L      &kp U     &kp Y   &kp SEMI          &kp BSLH
     &kp Q   &kp A   &kp R   &kp S   &kp T   &kp G          &kp M   &kp N      &kp E     &kp I      &kp O           &kp SQT
 &to LAYER_kuru  &kp Z   &kp X   &kp C   &kp D   &kp V      &kp K   &kp H  &kp COMMA   &kp DOT   &kp FSLH  &td_LAYER_Numbers
                    &kp LSHFT  &kp LA(BSPC)  &mo LAYER_All_layers    &vim_enter LAYER_Vim RET  &kp SPACE  &mo LAYER_Numbers
            >;
        };

        // ---- Numbers (also holds RGB + BT controls), Go60 rows R2/R3/R4 + thumbs ----
        layer_Numbers {
            bindings = <
 &none   &trans  &none   &kp N5   &kp END  &kp PG_UP        &kp KP_N7   &kp N6   &kp KP_N6  &none  &kp KP_SLASH  &none
 &none   &kp N1          &kp N2   &kp N3    &kp N4  &kp PG_DN           &kp N7   &kp N7      &kp N8          &kp N9        &kp N0  &none
 &none    &bt_1       &kp LC(X)    &none     &none     &none            &none    &none   &kp COMMA        &kp DOT         &bt_3  &none
                        &mo LAYER_All_layers   &trans   &to LAYER_kuru        &to LAYER_kuru   &trans   &kp KP_N0
            >;
        };

        // index 2 — TODO: port from go60.keymap layer_All_layers
        layer_All_layers {
            bindings = <
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      &trans &trans &trans &trans &trans &trans
            >;
        };

        // index 3 — TODO: port from go60.keymap layer_Vim
        layer_Vim {
            bindings = <
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
      &trans &trans &trans &trans &trans &trans
            >;
        };

        // index 4 — TODO: port from go60.keymap layer_Window_Manager
        layer_Window_Manager {
