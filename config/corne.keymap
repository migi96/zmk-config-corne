            label = "&TERMINAL_NARRATOR";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH>
                , <&kp U>
                , <&kp S>
                , <&kp R>
                , <&kp FSLH>
                , <&kp B>
                , <&kp I>
                , <&kp N>
                , <&kp FSLH>
                , <&kp S>
                , <&kp A>
                , <&kp Y>
                , <&kp SPACE>
                , <&kp LS(SQT)>
                , <&kp LS(SQT)>
                , <&kp LEFT>;
        };

        Terminal_voices9: Terminal_voices9 {
            label = "&TERMINAL_VOICES9";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH>
                , <&kp U>
                , <&kp S>
                , <&kp R>
                , <&kp FSLH>
                , <&kp B>
                , <&kp I>
                , <&kp N>
                , <&kp FSLH>
                , <&kp S>
                , <&kp A>
                , <&kp Y>
                , <&kp SPACE>
                , <&kp MINUS>
                , <&kp V>
                , <&kp SPACE>
                , <&kp SQT>
                , <&kp LS(FSLH)>
                , <&kp SQT>;
        };

        Terminal_voices_lists: Terminal_voices_lists {
            label = "&TERMINAL_VOICES_LISTS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH>
                , <&kp U>
                , <&kp S>
                , <&kp R>
                , <&kp FSLH>
                , <&kp B>
                , <&kp I>
                , <&kp N>
                , <&kp FSLH>
                , <&kp S>
                , <&kp A>
                , <&kp Y>
                , <&kp SPACE>
                , <&kp MINUS>
                , <&kp V>
                , <&kp SPACE>
                , <&kp LS(SQT)>
                , <&kp V>
                , <&kp O>
                , <&kp I>
                , <&kp C>
                , <&kp E>
                , <&kp SPACE>
                , <&kp N>
                , <&kp A>
                , <&kp M>
                , <&kp E>
                , <&kp LS(SQT)>
                , <&kp SPACE>
                , <&kp LS(SQT)>
                , <&kp LS(SQT)>
                , <&kp LEFT>;
        };

        // This will switch models ,github or chatgpt
        Open_code_switch_model: Open_code_switch_model {
            label = "&OPEN_CODE_SWITCH_MODEL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(P)>
                , <&kp M>;
        };

        // This will jump to any message on the prompt .... the previous ones
        Open_code_jump_to_msg: Open_code_jump_to_msg {
            label = "&OPEN_CODE_JUMP_TO_MSG";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp G>;
        };

        // This will undo the last message on the prompt ...
        Open_code_Undo_previous_msgs: Open_code_Undo_previous_msgs {
            label = "&OPEN_CODE_UNDO_PREVIOUS_MSGS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp U>;
        };

        // This will hide side bar.
        Open_code_hide_side_bar: Open_code_hide_side_bar {
            label = "&OPEN_CODE_HIDE_SIDE_BAR";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp B>;
        };

        // This can disable or enable code concealment in open code.
        Open_code_concealment: Open_code_concealment {
            label = "&OPEN_CODE_CONCEALMENT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp H>;
        };

        // This will open a new session for a prompt
        Open_code_new_session: Open_code_new_session {
            label = "&OPEN_CODE_NEW_SESSION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp N>;
        };

        // This will switch prompt sessions
        Open_code_switch_session: Open_code_switch_session {
            label = "&OPEN_CODE_SWITCH_SESSION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp L>;
        };

        //  This will copy the last assistant message
        Open_code_copy_last_message: Open_code_copy_last_message {
            label = "&OPEN_CODE_COPY_LAST_MESSAGE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp Y>;
        };

        // This will be compact session , as in it will explain what's the session / prompt was about and summary
        Open_code_compact_session: Open_code_compact_session {
            label = "&OPEN_CODE_COMPACT_SESSION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp C>;
        };

        // This will export session transcript in a md file .
        Open_code_export_session: Open_code_export_session {
            label = "&OPEN_CODE_EXPORT_SESSION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp X>;
        };

        // This will change open code theme
        Open_code_theme: Open_code_theme {
            label = "&OPEN_CODE_THEME";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>
                , <&kp T>;
        };

        // this a plugin in tmux that is created by dev-ops channel
        tmux_pop_window: tmux_pop_window {
            label = "&TMUX_POP_WINDOW";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp P>;
        };

        tmux_horizental_split: tmux_horizental_split {
            label = "&TMUX_HORIZENTAL_SPLIT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp LS(MINUS)>;
        };

        tmux_vertical_split: tmux_vertical_split {
            label = "&TMUX_VERTICAL_SPLIT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp LS(BSLH)>;
        };

        // This will go to currently playing tap
        surfingkey_playing_tab: surfingkey_playing_tab {
            label = "&SURFINGKEY_PLAYING_TAB";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G>
                , <&kp P>;
        };

        // this will download the best mp3 quality for the file using yt-dlp package
        youtube_mp3_best_quailty: youtube_mp3_best_quailty {
            label = "&YOUTUBE_MP3_BEST_QUAILTY";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y>
                , <&kp T>
                , <&kp MINUS>
                , <&kp D>
                , <&kp L>
                , <&kp P>
                , <&kp SPACE>
                , <&kp MINUS>
                , <&kp X>
                , <&kp SPACE>
                , <&kp MINUS>
                , <&kp MINUS>
                , <&kp A>
                , <&kp U>
                , <&kp D>
                , <&kp I>
                , <&kp O>
                , <&kp MINUS>
                , <&kp F>
                , <&kp O>
                , <&kp R>
                , <&kp M>
                , <&kp A>
                , <&kp T>
                , <&kp SPACE>
                , <&kp M>
                , <&kp P>
                , <&kp N3>
                , <&kp SPACE>
                , <&kp MINUS>
                , <&kp MINUS>
                , <&kp A>
                , <&kp U>
                , <&kp D>
                , <&kp I>
                , <&kp O>
                , <&kp MINUS>
                , <&kp Q>
                , <&kp U>
                , <&kp A>
                , <&kp L>
                , <&kp I>
                , <&kp T>
                , <&kp Y>
                , <&kp SPACE>
                , <&kp N0>
                , <&kp SPACE>
                , <&kp LS(SQT)>
                , <&kp LS(SQT)>
                , <&kp LEFT>;
        };

        Make_youtue_full_screen: Make_youtue_full_screen {
            label = "&MAKE_YOUTUE_FULL_SCREEN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G>
                , <&kp LS(F)>;
        };

        // This will open nvm editor for the current tmux window session , so i can copy / yank text.
        tmux_nvim_search_word: tmux_nvim_search_word {
            label = "&TMUX_NVIM_SEARCH_WORD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp Y>;
        };

        // (redacted)
        apple_password: apple_password {
            label = "&APPLE_PASSWORD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;  /* REDACTED: add real value in a local-only build */
        };

        // This will navigate to the previous agent on herdr
        previous_agent: previous_agent {
            label = "&PREVIOUS_AGENT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(N)>
                , <&kp R>;
        };

        herdr_last_pane: herdr_last_pane {
            label = "&HERDR_LAST_PANE";
            compatible = "zmk,behavior-macro";
