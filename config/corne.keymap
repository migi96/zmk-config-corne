                , <&kp I>
                , <&kp SQT>;
        };

        // vi" (Visual Inner Double-quote) functions exactly like the single-quote version but targets double quotes. In many languages, double quotes represent interpolated strings, and this command helps you select those complex expressions quickly.
        Double_Quote_Visual_Selection: Double_Quote_Visual_Selection {
            label = "&DOUBLE_QUOTE_VISUAL_SELECTION";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
