        // vi' (Visual Inner Single-quote) highlights all text between two single quotes. It "snaps" the selection to the boundaries of the string, allowing you to visually confirm the content before you perform an action.
        Single_Quote_Visual_Selection: Single_Quote_Visual_Selection {
            label = "&SINGLE_QUOTE_VISUAL_SELECTION";
