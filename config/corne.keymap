        // ci' (Change Inner Single-quote) performs the exact same action as the double-quote version but targets ' '.
        Single_Quote_Quick_Change: Single_Quote_Quick_Change {
            label = "&SINGLE_QUOTE_QUICK_CHANGE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
